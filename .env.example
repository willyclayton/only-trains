# Optional. Without it, Only Trains uses Transitous (free, no key) for routing.
# With it, Google Routes API (transit, rail-only modes) is used as a fallback
# where Transitous has no coverage. Enable "Routes API" in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional. Identifies your deployment to the free community APIs (Transitous,
# Photon). Please set a contact URL or email for your deployment.
ONLY_TRAINS_CONTACT=
